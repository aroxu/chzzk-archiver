ARCHIVER_SECRET_KEY=replace-with-a-long-random-value
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARCHIVER_COOKIE_ENCRYPTION_KEY=
ARCHIVER_SECURE_COOKIES=false

# VOD/clip download acceleration. Allowed maxima: segments 10, direct file 16.
ARCHIVER_DOWNLOAD_SEGMENT_THREADS=10
ARCHIVER_DOWNLOAD_CONNECTIONS=16

# disabled | local | remote. Remote uses HTTP only as the control plane and
# streams media over the full-duplex TCP port below.
ARCHIVER_ENCODING_MODE=local
ARCHIVER_ENCODING_VIDEO_ENCODER=auto
ARCHIVER_ENCODING_QUALITY=23
ARCHIVER_ENCODING_PRESET=medium
# copy saves space. Set flac24 to produce HEVC + 24-bit FLAC in MKV.
ARCHIVER_ENCODING_AUDIO=copy
ARCHIVER_MAX_ENCODINGS=1

# Required only when ARCHIVER_ENCODING_MODE=remote. Generate a long random value.
ARCHIVER_WORKER_TOKEN=
ARCHIVER_WORKER_STREAM_PORT=8011
# Public/VPN-reachable controller host advertised to remote workers.
ARCHIVER_WORKER_STREAM_HOST=

# Remote worker runtime (put these in a .env beside the worker binary, or pass
# them as real environment variables). The encoder setting above is shared by
# the controller and worker. Use auto for tested GPU-first selection.
ARCHIVER_WORKER_SERVER=
ARCHIVER_WORKER_ID=
ARCHIVER_WORKER_FFMPEG=ffmpeg
ARCHIVER_WORKER_POLL_INTERVAL=5
