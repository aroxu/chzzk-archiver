{
  "manifest_version":3,
  "name":"CHZZK Archive Connector",
  "version":"0.1.0",
  "description":"치지직 로그인 쿠키를 내 아카이브에 안전하게 동기화합니다.",
  "permissions":["cookies","storage","alarms"],
  "host_permissions":["https://*.naver.com/*","https://chzzk.naver.com/*","http://localhost/*"],
  "background":{"service_worker":"background.js"},
  "action":{"default_popup":"popup.html","default_title":"CHZZK Archive"}
}

